{
  "info": {
    "_postman_id": "freshioz-enterprise-api-collection-2026",
    "name": "Freshioz Enterprise REST API",
    "description": "Complete production API collection for Freshioz Farm-to-Fork Direct Supply Chain Platform (User Web, Admin Operations Desk, Society Partner Portal).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.freshioz.com",
      "type": "string",
      "description": "Production API base domain or http://localhost:5000 for local development"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token automatically populated after login"
    }
  ],
  "item": [
    {
      "name": "1. Health & Diagnostics",
      "item": [
        {
          "name": "API & Database Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Checks system status, server IST time, and live PostgreSQL database connectivity latency."
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Staff / Super Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('JWT Token successfully set in collection variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@freshioz.com\",\n  \"password\": \"Freshioz@SuperAdmin2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in Super Admin, Warehouse Manager, or Staff. Sets the token variable automatically in Postman tests."
          }
        },
        {
          "name": "Society / Hostel Partner Portal Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"societyId\": \"FRZ_SOC_101\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Freshioz@Society2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/partner-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "partner-login"]
            },
            "description": "Authenticates community representatives (Apartment Presidents/Secretaries/Wardens) for commission ledger and payouts."
          }
        },
        {
          "name": "Customer Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Sharma\",\n  \"phone\": \"9876543210\",\n  \"societyId\": \"FRZ_SOC_101\",\n  \"flatNo\": \"Tower 2 - Flat 402\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Verify Current Token",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
